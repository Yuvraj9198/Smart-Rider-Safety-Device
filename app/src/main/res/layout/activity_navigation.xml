<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NavigationActivity">

    <!-- Destination Input with Autocomplete -->
    <AutoCompleteTextView
        android:id="@+id/destination_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Enter destination"
        android:padding="10dp"
        android:background="?android:attr/editTextBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Start Navigation Button -->
    <Button
        android:id="@+id/start_navigation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Navigation"
        app:layout_constraintTop_toBottomOf="@id/destination_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>
    <!-- Initially hidden -->

    <!-- Navigation Instructions -->
    <FrameLayout
    android:id="@+id/fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"/>


    <!-- Instructions TextView -->
    <TextView
        android:id="@+id/navigation_steps"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Instructions will appear here"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/start_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <!-- Google Maps Fragment -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/mapView"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_steps" />

</androidx.constraintlayout.widget.ConstraintLayout>
